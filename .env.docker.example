# Copy this file to `.env` before using docker compose if you want to override defaults.

CODEDOC_API_PORT=8000
CODEDOC_FRONTEND_PORT=5173

CODEDOC_CHAT_MODEL=qwen3.5:4b
CODEDOC_CHAT_API_KEY=EMPTY
CODEDOC_CHAT_TIMEOUT_SECONDS=180
CODEDOC_CHAT_MAX_TOKENS=600
CODEDOC_CHAT_TEMPERATURE=0.1

CODEDOC_EMBEDDING_MODEL=bge-m3
CODEDOC_EMBEDDING_DIMENSION=1024
CODEDOC_EMBEDDING_BATCH_SIZE=8
CODEDOC_EMBEDDING_TIMEOUT_SECONDS=180

# Docker demo defaults to mock rerank for portability.
# To use a real local reranker, install dependencies and mount the model path explicitly.
CODEDOC_RERANK_PROVIDER=mock
CODEDOC_RERANK_MODEL=mock-reranker

VECTOR_STORE_BACKEND=qdrant
QDRANT_COLLECTION=codedoc_chunks_v1
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

REDIS_PORT=6379
OLLAMA_PORT=11434
