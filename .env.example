CODEDOC_CHAT_PROVIDER=mock
CODEDOC_CHAT_MODEL=mock-chat-model
CODEDOC_CHAT_BASE_URL=http://localhost:11434/v1
CODEDOC_CHAT_API_KEY=EMPTY
CODEDOC_CHAT_TIMEOUT_SECONDS=30
CODEDOC_CHAT_TEMPERATURE=0.2
CODEDOC_CHAT_MAX_TOKENS=800

# Embedding provider:
# - mock: local deterministic hash embedding, no network required
# - ollama: Ollama native embedding API, for example http://localhost:11434
# - openai_compatible: OpenAI-compatible /v1/embeddings service
CODEDOC_EMBEDDING_PROVIDER=mock
CODEDOC_EMBEDDING_MODEL=mock-hash-embedding
CODEDOC_EMBEDDING_BASE_URL=http://localhost:11434
CODEDOC_EMBEDDING_API_KEY=
CODEDOC_EMBEDDING_TIMEOUT_SECONDS=30
CODEDOC_EMBEDDING_DIMENSION=64
CODEDOC_EMBEDDING_BATCH_SIZE=16
CODEDOC_EMBEDDING_MAX_RETRIES=2
CODEDOC_EMBEDDING_RETRY_BACKOFF_SECONDS=1
CODEDOC_NORMALIZE_EMBEDDING=true
CODEDOC_VECTOR_INDEX_PATH=outputs/vector_index.json

# VectorStore backend: json or qdrant
VECTOR_STORE_BACKEND=json
VECTOR_STORE_PROJECT_ID=1
VECTOR_INDEX_PATH=outputs/vector_index.json
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codedoc_chunks_v1
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=10

# Day42 async runtime and single-process ingestion jobs
CODEDOC_ASYNC_MODEL_MAX_CONCURRENCY=2
CODEDOC_ASYNC_CALL_TIMEOUT_SECONDS=60
CODEDOC_ASYNC_MAX_ATTEMPTS=3
CODEDOC_ASYNC_RETRY_BASE_DELAY_SECONDS=0.5
CODEDOC_ASYNC_RETRY_MAX_DELAY_SECONDS=8
CODEDOC_ASYNC_RETRY_JITTER_SECONDS=0.2
CODEDOC_INGESTION_MAX_RUNNING_JOBS=2
CODEDOC_INGESTION_JOB_DB_PATH=data/ingestion_jobs.sqlite
CODEDOC_RERANK_BASE_URL=http://localhost:8001/v1
CODEDOC_RERANK_API_KEY=
