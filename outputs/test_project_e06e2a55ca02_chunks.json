    "signature": "def setup_logger(name: str='test_project') -> logging.Logger",
    "start_line": 12,
    "end_line": 27,
    "docstring": "\n    初始化并返回测试项目 logger。\n    ",
    "parser": "python_ast",
    "parse_error": null,
    "symbol_index": 1,
    "chunk_index": 1,
    "part_index": 0,
    "part_count": 1,
    "content": "def setup_logger(name: str = \"test_project\") -> logging.Logger:\n    \"\"\"\n    初始化并返回测试项目 logger。\n    \"\"\"\n    logger = logging.getLogger(name)\n    logger.setLevel(DEFAULT_LOG_LEVEL)\n\n    if not logger.handlers:\n        handler = logging.StreamHandler()\n        formatter = logging.Formatter(\n            \"%(levelname)s | %(name)s | %(message)s\"\n        )\n        handler.setFormatter(formatter)\n        logger.addHandler(handler)\n\n    return logger",
    "length": 445
  },
