    "content": "def keyword_score(query: str, text: str) -> int:\n    \"\"\"\n    根据 query 中的关键词在文本中出现的次数计算简单分数。\n    \"\"\"\n    terms = [\n        term.lower()\n        for term in query.split()\n        if term.strip()\n    ]\n\n    lower_text = text.lower()\n\n    return sum(\n        lower_text.count(term)\n        for term in terms\n    )",
